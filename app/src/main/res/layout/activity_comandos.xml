<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/exy_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <include
            android:id="@+id/barra"
            layout="@layout/barra" />

        <TextView
            style="@style/Exy.Label"
            android:layout_marginTop="8dp"
            android:text="@string/favorito_titulo" />

        <LinearLayout style="@style/Exy.Card">

            <include
                android:id="@+id/filaFavorito"
                layout="@layout/item_accion" />
        </LinearLayout>

        <TextView
            style="@style/Exy.Hint"
            android:text="@string/favorito_ayuda" />

        <TextView
            style="@style/Exy.Label"
            android:text="@string/tus_comandos" />

        <LinearLayout
            android:id="@+id/listaPropios"
            style="@style/Exy.Card" />

        <TextView
            android:id="@+id/txtSinPropios"
            style="@style/Exy.Hint"
            android:text="@string/sin_comandos_propios" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregar"
            style="@style/Exy.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="@string/agregar_app"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart" />

        <TextView
            style="@style/Exy.Label"
            android:text="@string/integrados" />

        <LinearLayout
            android:id="@+id/listaIntegrados"
            style="@style/Exy.Card" />
    </LinearLayout>
</ScrollView>
