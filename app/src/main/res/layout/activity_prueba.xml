<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/exy_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <include
            android:id="@+id/barra"
            layout="@layout/barra" />

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <cl.exy.app.OrbeView
                android:id="@+id/orbe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/imgX"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/x_apagada" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtEstado"
            style="@style/Exy.State"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/txtDetalle"
            style="@style/Exy.Sub"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/txtParcial"
            style="@style/Exy.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_heard"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textSize="13sp"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrueba"
            style="@style/Exy.Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/lblResultados"
            style="@style/Exy.Label"
            android:text="@string/prueba_resultados" />

        <LinearLayout
            android:id="@+id/listaResultados"
            style="@style/Exy.Card" />

        <TextView
            style="@style/Exy.Hint"
            android:layout_marginTop="12dp"
            android:text="@string/prueba_ayuda" />
    </LinearLayout>
</ScrollView>
