<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/exy_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Brillo azul del logo detrás del estado -->
        <View
            android:layout_width="520dp"
            android:layout_height="520dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-40dp"
            android:background="@drawable/bg_glow"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/contenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Encabezado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/logo_exy" />

                <TextView
                    style="@style/Exy.Brand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/txtVersion"
                    style="@style/Exy.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="v1.0.20" />
            </LinearLayout>

            <!-- Versión nueva disponible (solo si la hay) -->
            <LinearLayout
                android:id="@+id/bannerActualizacion"
                style="@style/Exy.Card"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtActualizacion"
                    style="@style/Exy.ItemTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDescargar"
                    style="@style/Exy.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/descargar" />
            </LinearLayout>

            <!-- Estado principal: la X del logo dentro del anillo -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <cl.exy.app.OrbeView
                    android:id="@+id/orbe"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/imgX"
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/x_apagada" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtEstado"
                style="@style/Exy.State"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                tools:text="Escuchando" />

            <TextView
                android:id="@+id/txtDetalle"
                style="@style/Exy.Sub"
                android:layout_marginTop="6dp"
                tools:text="Di «Oye Exi» de corrido, sin pausa." />

            <TextView
                android:id="@+id/txtOido"
                style="@style/Exy.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_heard"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:textSize="13sp"
                tools:text="último: «oye exi claude»" />

            <!-- Acciones: una principal por estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrimario"
                    style="@style/Exy.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    tools:text="Escuchar ya" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPausar"
                    style="@style/Exy.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/btn_pausar"
                    app:icon="@drawable/ic_pause"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetener"
                    style="@style/Exy.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/btn_stop" />
            </LinearLayout>

            <!-- Primeros pasos (solo mientras falte algún permiso) -->
            <LinearLayout
                android:id="@+id/seccionPasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPasos"
                    style="@style/Exy.Label"
                    tools:text="Primeros pasos · 2 de 4" />

                <LinearLayout
                    style="@style/Exy.Card"
                    android:paddingTop="14dp">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progresoPasos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="4dp"
                        android:max="4"
                        app:indicatorColor="@color/exy_mint"
                        app:trackColor="#12FFFFFF"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="4dp" />

                    <LinearLayout
                        android:id="@+id/listaPasos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- Comandos de voz -->
            <TextView
                style="@style/Exy.Label"
                android:text="@string/section_comandos" />

            <LinearLayout
                android:id="@+id/listaComandos"
                style="@style/Exy.Card" />

            <!-- Herramientas -->
            <TextView
                style="@style/Exy.Label"
                android:text="@string/section_herramientas" />

            <LinearLayout style="@style/Exy.Card">

                <include
                    android:id="@+id/filaPrueba"
                    layout="@layout/item_accion" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/exy_hair" />

                <include
                    android:id="@+id/filaHistorial"
                    layout="@layout/item_accion" />
            </LinearLayout>

            <!-- Permisos listos (reemplaza a los pasos cuando ya están todos) -->
            <LinearLayout
                android:id="@+id/permisosListos"
                style="@style/Exy.Card"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check" />

                <TextView
                    style="@style/Exy.ItemTitle"
                    android:layout_marginStart="12dp"
                    android:text="@string/permisos_listos" />
            </LinearLayout>

            <!-- Ajustes -->
            <TextView
                style="@style/Exy.Label"
                android:text="@string/section_precision" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoPrecision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/precisionEstricta"
                    style="@style/Exy.Segment"
                    android:text="@string/precision_estricta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/precisionNormal"
                    style="@style/Exy.Segment"
                    android:text="@string/precision_normal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/precisionSensible"
                    style="@style/Exy.Segment"
                    android:text="@string/precision_sensible" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/txtPrecision"
                style="@style/Exy.Hint" />

            <TextView
                style="@style/Exy.Label"
                android:text="@string/section_tiempo" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoTiempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tiempo30"
                    style="@style/Exy.Segment"
                    android:text="@string/tiempo_30" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tiempo60"
                    style="@style/Exy.Segment"
                    android:text="@string/tiempo_60" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tiempo120"
                    style="@style/Exy.Segment"
                    android:text="@string/tiempo_120" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tiempo300"
                    style="@style/Exy.Segment"
                    android:text="@string/tiempo_300" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/Exy.Hint"
                android:text="@string/help_tiempo" />

            <!-- Pausas automáticas -->
            <TextView
                style="@style/Exy.Label"
                android:text="@string/section_automatico" />

            <LinearLayout style="@style/Exy.Card">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swDescanso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/descanso"
                    android:textColor="@color/exy_text"
                    android:textSize="15sp"
                    app:thumbTint="@color/switch_thumb"
                    app:trackTint="@color/switch_track" />

                <LinearLayout
                    android:id="@+id/filaHoras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDesde"
                        style="@style/Exy.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHasta"
                        style="@style/Exy.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/exy_hair" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAuriculares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/auriculares"
                    android:textColor="@color/exy_text"
                    android:textSize="15sp"
                    app:thumbTint="@color/switch_thumb"
                    app:trackTint="@color/switch_track" />
            </LinearLayout>

            <TextView
                style="@style/Exy.Hint"
                android:text="@string/automatico_ayuda" />

            <!-- Pie -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuscarActualizacion"
                style="@style/Exy.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="@string/buscar_actualizacion" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
