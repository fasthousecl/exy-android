<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            style="@style/Exy.Help"
            android:layout_marginTop="4dp"
            android:text="@string/intro" />

        <!-- Servicio -->
        <TextView
            style="@style/Exy.Section"
            android:text="@string/section_service" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/txtLastHeard"
            style="@style/Exy.Help"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestAssistant"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_test_assistant" />
        </LinearLayout>

        <!-- Ajustes -->
        <TextView
            style="@style/Exy.Section"
            android:text="@string/section_tuning" />

        <TextView
            android:id="@+id/txtSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:valueFrom="0.0"
            android:valueTo="1.0" />

        <TextView
            style="@style/Exy.Help"
            android:text="@string/help_sensitivity" />

        <TextView
            android:id="@+id/txtResumeDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderResumeDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="10"
            android:valueTo="300" />

        <TextView
            style="@style/Exy.Help"
            android:text="@string/help_resume_delay" />

        <!-- Permisos -->
        <TextView
            style="@style/Exy.Section"
            android:text="@string/section_permissions" />

        <LinearLayout style="@style/Exy.PermRow">

            <TextView
                style="@style/Exy.PermLabel"
                android:text="@string/perm_mic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermMic"
                style="@style/Exy.PermButton" />
        </LinearLayout>

        <LinearLayout style="@style/Exy.PermRow">

            <TextView
                style="@style/Exy.PermLabel"
                android:text="@string/perm_notifications" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermNotif"
                style="@style/Exy.PermButton" />
        </LinearLayout>

        <LinearLayout style="@style/Exy.PermRow">

            <TextView
                style="@style/Exy.PermLabel"
                android:text="@string/perm_overlay" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermOverlay"
                style="@style/Exy.PermButton" />
        </LinearLayout>

        <LinearLayout style="@style/Exy.PermRow">

            <TextView
                style="@style/Exy.PermLabel"
                android:text="@string/perm_battery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermBattery"
                style="@style/Exy.PermButton" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtVersion"
            style="@style/Exy.Help"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
