<?xml version="1.0" encoding="utf-8"?>
<!-- Nada se respalda ni se copia a otro equipo: la AccessKey va cifrada con una
     llave del Keystore que no sale del teléfono, así que restaurarla en otro
     aparato no serviría de nada. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
